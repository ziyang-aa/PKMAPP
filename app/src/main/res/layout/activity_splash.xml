<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="小松果启动画面"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_buffer_page" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="88dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_leaf"
            android:tint="@color/forest_deep" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:letterSpacing="0.14"
            android:text="小松果"
            android:textColor="@color/forest_deep"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.06"
            android:text="把生活与成长，收进温暖森林"
            android:textColor="@color/wood_brown"
            android:textSize="13sp" />

        <com.example.pkmapp.forest.ForestLoadingView
            android:id="@+id/splash_loading"
            android:layout_width="78dp"
            android:layout_height="34dp"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</FrameLayout>
