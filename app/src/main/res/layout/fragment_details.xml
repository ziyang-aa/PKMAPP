<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fixed_forest_backdrop"
    android:clipToPadding="false"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/page_back_button"
                android:layout_width="88dp"
                android:layout_height="72dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回主页面"
                android:scaleType="centerInside"
                android:src="@drawable/return_home_door" />

            <TextView
                android:id="@+id/title_details"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="明细"
                android:textColor="@color/forest_green"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/details_filter_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/details_ledger_switch_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_details_ledger_button"
                android:clickable="true"
                android:contentDescription="切换或新建账本"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/space_12"
                android:text="当前账本  ›"
                android:textColor="@color/wood_brown"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/details_month_picker_button"
                android:layout_width="112dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_details_month_button"
                android:clickable="true"
                android:contentDescription="选择查看月份"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="2026年9月⌄"
                android:textColor="@color/wood_brown"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/details_current_month_button"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_details_current_month"
                android:clickable="true"
                android:contentDescription="回到本月"
                android:focusable="true"
                android:gravity="center"
                android:text="本月"
                android:textColor="@color/forest_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/details_ledger_name"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible" />

        <FrameLayout
            android:id="@+id/details_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="220dp"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_details_balance_card_v2"
            android:clipChildren="true"
            android:clipToPadding="true">

            <View
                android:layout_width="220dp"
                android:layout_height="260dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-30dp"
                android:layout_marginEnd="-36dp"
                android:alpha="0.72"
                android:background="@drawable/bg_details_balance_blob"
                android:rotation="18" />

            <ImageView
                android:layout_width="218dp"
                android:layout_height="144dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-28dp"
                android:layout_marginBottom="-38dp"
                android:alpha="0.7"
                android:background="@drawable/bg_details_balance_blob"
                android:rotation="-12" />

            <ImageView
                android:layout_width="205dp"
                android:layout_height="205dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-20dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="妙蛙种子把金币存进储蓄罐"
                android:scaleType="fitCenter"
                android:src="@drawable/balance_bulbasaur_coin" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="120dp"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_16"
                android:paddingEnd="0dp"
                android:paddingBottom="@dimen/space_12">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="本月结余 · FOREST BALANCE"
                    android:textColor="@color/wood_brown"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/details_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textColor="@color/forest_deep"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="每一笔记录，都会留下新的叶脉"
                    android:textColor="#9A8268"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_8">

                    <TextView
                        android:id="@+id/details_income"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="@dimen/space_8"
                        android:paddingBottom="@dimen/space_8"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/space_8"
                        android:alpha="0.16"
                        android:background="@color/forest_green" />

                    <TextView
                        android:id="@+id/details_expense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:paddingEnd="@dimen/space_8"
                        android:paddingBottom="@dimen/space_8"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_12"
                android:background="@drawable/bg_details_observer_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_8">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="35dp"
                    android:contentDescription="木守宫观察藤蔓"
                    android:scaleType="fitCenter"
                    android:src="@drawable/balance_treecko_observe" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="发现新叶 +1"
                    android:textColor="@color/forest_deep"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/details_growth_note"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_details_growth_note"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_12">

            <View
                android:layout_width="22dp"
                android:layout_height="2dp"
                android:background="@color/leaf_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="木守宫的观察记录"
                    android:textColor="@color/forest_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="藤蔓正在长出新叶，继续保持记录。"
                    android:textColor="@color/wood_brown"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/details_tools_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="森林小工具"
                    android:textColor="@color/wood_brown"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="轻量入口"
                    android:textColor="@color/wood_brown"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/details_fx_tool_button"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_details_tool_button"
                    android:clickable="true"
                    android:contentDescription="汇率换算工具"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_12">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_chart"
                        android:tint="@color/warm_orange" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="汇率换算"
                            android:textColor="@color/ink"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="联网同步最新汇率"
                            android:textColor="@color/wood_brown"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/details_borrowing_tool_button"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:background="@drawable/bg_details_tool_button"
                    android:clickable="true"
                    android:contentDescription="借钱统计工具"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_12">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_savings"
                        android:tint="@color/warm_orange" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="借钱统计"
                            android:textColor="@color/ink"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="记录来往关系"
                            android:textColor="@color/wood_brown"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="交易记录"
                android:textColor="@color/wood_brown"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="按日期归档"
                android:textColor="@color/wood_brown"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/details_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_24">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="还没有记账记录"
                android:textColor="@color/wood_brown" />

            <TextView
                android:id="@+id/details_add_record_button"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_details_current_month"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="去记一笔"
                android:textColor="@color/forest_green"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/details_transaction_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
