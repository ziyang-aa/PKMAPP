<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/page_back_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:contentDescription="返回大厅"
                android:scaleType="centerInside"
                android:src="@drawable/return_home_door"
                android:stateListAnimator="@animator/editorial_press_alpha" />

            <TextView
                android:id="@id/title_feedback"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:gravity="end"
                android:text="意见反馈"
                android:textColor="@color/forest_green"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_paper_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:scaleType="centerInside"
                android:src="@drawable/deer_observer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="USER FEEDBACK"
                    android:textColor="@color/wood_brown"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="serif"
                    android:text="听见你的声音"
                    android:textColor="@color/forest_deep"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="离线也会妥善保存，联网后自动送达"
                    android:textColor="@color/wood_brown"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_paper_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="反馈类型"
                android:textColor="@color/wood_brown"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/feedback_category_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="详细描述（5–500 字）"
                android:textColor="@color/wood_brown"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/feedback_content_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@null"
                android:gravity="top|start"
                android:hint="请描述遇到的问题场景、预期效果，或您想要的新功能..."
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:minHeight="96dp"
                android:paddingVertical="6dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/brown_soft"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#265C4938" />

            <TextView
                android:id="@+id/feedback_char_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:text="0 / 500"
                android:textColor="@color/brown_soft"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="联系方式（选填，便于回访进展）"
                android:textColor="@color/wood_brown"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/feedback_contact_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@null"
                android:hint="手机号 / 邮箱 / 微信号（可留空）"
                android:inputType="text"
                android:maxLength="60"
                android:minHeight="44dp"
                android:paddingVertical="6dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/brown_soft"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#265C4938" />

            <TextView
                android:id="@+id/feedback_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/expense_red"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/feedback_submit_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="提交反馈"
                android:textColor="@color/paper_light"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#456444"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="我的反馈记录"
                android:textColor="@color/forest_deep"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/feedback_history_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="共 0 条"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/feedback_history_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_paper_card"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />
    </LinearLayout>
</ScrollView>
