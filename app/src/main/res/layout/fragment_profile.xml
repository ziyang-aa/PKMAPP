<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/page_back_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回主页面"
                android:scaleType="centerInside"
                android:src="@drawable/return_home_door" />

            <TextView
                android:id="@+id/title_profile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="森林档案"
                android:textColor="@color/forest_green"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_profile_hero"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/profile_nickname_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/profile_avatar_button"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_profile_avatar_ring"
                        android:clickable="true"
                        android:contentDescription="更换头像"
                        android:focusable="true"
                        android:padding="4dp">

                        <ImageView
                            android:id="@+id/profile_avatar_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_profile_avatar"
                            android:clipToOutline="true"
                            android:contentDescription="当前头像"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_launcher_character" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/profile_nickname"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="森林守护员"
                                android:textColor="@color/forest_green"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/profile_nickname_edit"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginStart="2dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="修改昵称"
                                android:padding="6dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/profile_pencil" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/profile_streak_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="已在这里生活 0 天"
                            android:textColor="#5F7951"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/profile_guardian_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_profile_level"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_8"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_leaf"
                        android:tint="@color/forest_green" />

                    <TextView
                        android:id="@+id/profile_level_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:text="Lv.1 · 林间新芽"
                        android:textColor="@color/wood_brown"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="124dp"
                android:layout_height="112dp"
                android:contentDescription="正在休息的小熊"
                android:scaleType="centerInside"
                android:src="@drawable/bulbasaur_sleeping" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_profile_asset"
            android:clipChildren="false">



            <LinearLayout
                android:id="@+id/profile_asset_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="森林资产总览"
                    android:textColor="@color/wood_brown"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profile_manage_assets_button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_profile_asset_action"
                    android:clickable="true"
                    android:contentDescription="管理我的资产和负债"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="管理我的资产  ›"
                    android:textColor="@color/forest_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/profile_asset_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:fontFamily="serif"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="-0.02"
                android:text="¥0.00"
                android:textColor="@color/forest_deep"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profile_asset_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="当前资产 · 收入与支出会实时更新"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="#335C4938" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="净资产"
                        android:textColor="@color/wood_brown"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/profile_net_worth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="¥0.00"
                        android:textColor="@color/forest_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="负债"
                        android:textColor="@color/wood_brown"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/profile_liability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="¥0.00"
                        android:textColor="@color/warm_orange"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/profile_checkin_button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_profile_checkin"
            android:clickable="true"
            android:contentDescription="打开每日打卡日历"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_12">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_profile_level"
                android:padding="@dimen/space_8">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription=""
                    android:src="@drawable/ic_leaf"
                    android:tint="@color/forest_green" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="每日签到"
                    android:textColor="@color/wood_brown"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profile_checkin_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="累计打卡 27 天 · Lv.4 小树林守护者"
                    android:textColor="@color/wood_brown"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/profile_checkin_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="去签到 ›"
                android:textColor="@color/forest_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="小屋管理"
                android:textColor="@color/wood_brown"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="轻轻调整"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_category_manage_button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="管理记账分类"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_profile_icon"
                android:contentDescription=""
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_list"
                android:tint="@color/wood_brown" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="分类管理"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profile_category_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22 个分类  ·›"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#C2DDCF" />

        <LinearLayout
            android:id="@+id/profile_ledger_manage_button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="管理账本"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_profile_icon"
                android:contentDescription=""
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_add_ledger"
                android:tint="@color/wood_brown" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="账本管理"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profile_ledger_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 本账本  ·›"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#C2DDCF" />

        <LinearLayout
            android:id="@+id/profile_export_data_button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_profile_icon"
                android:contentDescription=""
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_download"
                android:tint="@color/wood_brown" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="导出账单"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JSON 备份  ·›"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#C2DDCF" />

        <LinearLayout
            android:id="@+id/profile_import_data_button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_profile_icon"
                android:contentDescription=""
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_download"
                android:tint="@color/wood_brown" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="导入账单"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择备份文件  ·›"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#C2DDCF" />

        <LinearLayout
            android:id="@+id/profile_clear_data_button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_details_delete_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_profile_icon"
                android:contentDescription=""
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_delete"
                android:tint="@color/expense_red" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="清空数据"
                android:textColor="@color/expense_red"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="恢复初始状态  ·›"
                android:textColor="@color/expense_red"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="其他"
                android:textColor="@color/wood_brown"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关于森林账本"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_profile_icon"
                android:contentDescription=""
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_savings"
                android:tint="@color/wood_brown" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="设置"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="·›"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#C2DDCF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_profile_icon"
                android:contentDescription=""
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_info"
                android:tint="@color/wood_brown" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="关于森林账本"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v0.1  ·›"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center"
            android:paddingBottom="@dimen/space_16"
            android:text="愿每一笔记录，都让生活更清楚一点。"
            android:textColor="@color/wood_brown"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
