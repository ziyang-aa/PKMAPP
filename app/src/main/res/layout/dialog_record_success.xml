<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_record_success_dialog"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_leaf" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="收录成功"
        android:textColor="@color/forest_green"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="这笔记录已经放进当前森林账本"
        android:textColor="@color/wood_brown"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/record_success_continue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_record_success_secondary_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="继续记一笔"
            android:textColor="@color/forest_green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/record_success_details"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_savings_save"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="查看明细"
            android:textColor="@color/paper_light"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
