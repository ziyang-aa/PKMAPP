<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ultra-fine sage hairline -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#22456444" />
        </shape>
    </item>
    <!-- Soft porcelain-to-sage-mist editorial surface -->
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="135"
                android:startColor="#FFFEFA"
                android:centerColor="#F8FAF3"
                android:endColor="#ECF3E4" />
        </shape>
    </item>
    <!-- Subtle top inner specular highlight -->
    <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="22.5dp" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
