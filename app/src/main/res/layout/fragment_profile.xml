<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fixed_forest_backdrop"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_16">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="208dp"
            android:clipChildren="false">

            <ImageButton
                android:id="@+id/page_back_button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="start|top"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回主页面"
                android:scaleType="centerInside"
                android:src="@drawable/return_home_door" />

            <FrameLayout
                android:id="@+id/profile_avatar_button"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="44dp"
                android:background="@drawable/bg_profile_avatar_ring"
                android:clickable="true"
                android:contentDescription="更换头像"
                android:focusable="true"
                android:elevation="4dp"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/profile_avatar_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_profile_avatar"
                    android:clipToOutline="true"
                    android:contentDescription="当前头像"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_character" />
            </FrameLayout>

            <RelativeLayout
                android:id="@+id/profile_nickname_row"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="154dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/profile_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="森林守护员"
                    android:textColor="@color/wood_brown"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/profile_nickname_edit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_toEndOf="@id/profile_nickname"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="修改昵称"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/profile_pencil" />
            </RelativeLayout>

            <TextView
                android:id="@+id/title_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:text="森林档案"
                android:textColor="@color/forest_green"
                android:textSize="23sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="232dp"
            android:background="@drawable/bg_profile_hero"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_16">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="MY FOREST FILE"
                    android:textColor="@color/forest_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profile_guardian_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="森林守护员"
                    android:textColor="@color/forest_green"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profile_streak_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="已在这里生活 27 天"
                    android:textColor="#5F7951"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_profile_level"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_8"
                    android:paddingEnd="@dimen/space_8">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_leaf"
                        android:tint="@color/forest_green" />

                    <TextView
                        android:id="@+id/profile_level_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:text="Lv.4 · 小树林守护者"
                        android:textColor="@color/wood_brown"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:contentDescription="正在休息的妙蛙种子"
                android:scaleType="centerInside"
                android:src="@drawable/bulbasaur_sleeping"
                android:translationY="8dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_profile_asset"
            android:clipChildren="false">

            <ImageView
                android:layout_width="116dp"
                android:layout_height="92dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/space_8"
                android:alpha="0.94"
                android:contentDescription=""
                android:scaleType="centerInside"
                android:src="@drawable/asset_treasure_chest"
                android:translationY="24dp" />

            <ImageView
                android:layout_width="58dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="112dp"
                android:alpha="0.92"
                android:contentDescription=""
                android:scaleType="centerInside"
                android:src="@drawable/asset_coin_stack"
                android:translationY="40dp" />

            <LinearLayout
                android:id="@+id/profile_asset_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="森林资产总览"
                    android:textColor="@color/wood_brown"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profile_manage_assets_button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_profile_asset_action"
                    android:clickable="true"
                    android:contentDescription="管理我的资产和负债"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:text="管理我的资产  ›"
                    android:textColor="@color/forest_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/profile_asset_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="¥0.00"
                android:textColor="@color/forest_green"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="当前资产 · 收入与支出会实时更新"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="#335C4938" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="净资产"
                        android:textColor="@color/wood_brown"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/profile_net_worth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="¥0.00"
                        android:textColor="@color/forest_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="负债"
                        android:textColor="@color/wood_brown"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/profile_liability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="¥0.00"
                        android:textColor="@color/warm_orange"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/profile_checkin_button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_profile_checkin"
            android:clickable="true"
            android:contentDescription="打开每日打卡日历"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_12">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_profile_level"
                android:padding="@dimen/space_8">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription=""
                    android:src="@drawable/ic_leaf"
                    android:tint="@color/forest_green" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="每日签到"
                    android:textColor="@color/wood_brown"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profile_checkin_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="累计打卡 27 天 · Lv.4 小树林守护者"
                    android:textColor="@color/wood_brown"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/profile_checkin_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="去签到 ›"
                android:textColor="@color/forest_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="小屋管理"
                android:textColor="@color/wood_brown"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="轻轻调整"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_profile_icon"
                android:contentDescription=""
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_list"
                android:tint="@color/wood_brown" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="分类管理"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22 个分类  ·›"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#C2DDCF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_profile_icon"
                android:contentDescription=""
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_add_ledger"
                android:tint="@color/wood_brown" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="账本管理"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 本账本  ·›"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#C2DDCF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_profile_icon"
                android:contentDescription=""
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_download"
                android:tint="@color/wood_brown" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="导出账本"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CSV  ·›"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#C2DDCF" />

        <LinearLayout
            android:id="@+id/profile_clear_data_button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_details_delete_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_profile_icon"
                android:contentDescription=""
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_delete"
                android:tint="@color/expense_red" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="清空数据"
                android:textColor="@color/expense_red"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="恢复初始状态  ·›"
                android:textColor="@color/expense_red"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="其他"
                android:textColor="@color/wood_brown"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关于森林账本"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_profile_icon"
                android:contentDescription=""
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_savings"
                android:tint="@color/wood_brown" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="设置"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="·›"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#C2DDCF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_profile_icon"
                android:contentDescription=""
                android:padding="@dimen/space_4"
                android:src="@drawable/ic_info"
                android:tint="@color/wood_brown" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="关于森林账本"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v0.1  ·›"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center"
            android:paddingBottom="@dimen/space_16"
            android:text="愿每一笔记录，都让生活更清楚一点。"
            android:textColor="@color/wood_brown"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
