<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper_light" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#94B284" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper_deep" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#94B284" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#73FFFDF2" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#335C4938" />
        </shape>
    </item>
</selector>
