<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream_background" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_24">
  <TextView android:id="@+id/title_record" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="记账" android:textColor="@color/forest_green" android:textSize="28sp" android:textStyle="bold"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/page_back_button" android:layout_width="wrap_content" android:layout_height="48dp" android:text="返回主页面"/>
  <com.google.android.material.button.MaterialButtonToggleGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" app:singleSelection="true" app:selectionRequired="true">
   <com.google.android.material.button.MaterialButton android:id="@+id/record_type_expense" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="支出"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/record_type_income" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="收入"/>
  </com.google.android.material.button.MaterialButtonToggleGroup>
  <LinearLayout style="@style/Widget.PkmAPP.PaperCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:orientation="vertical" android:padding="@dimen/space_16">
   <com.google.android.material.textfield.TextInputLayout android:id="@+id/record_amount_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="金额" app:prefixText="¥"><com.google.android.material.textfield.TextInputEditText android:id="@+id/record_amount_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal"/></com.google.android.material.textfield.TextInputLayout>
   <com.google.android.material.button.MaterialButton android:id="@+id/record_calculator_button" android:layout_width="wrap_content" android:layout_height="48dp" android:text="计算器"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:text="分类" android:textColor="@color/ink" android:textStyle="bold"/>
   <com.google.android.material.chip.ChipGroup android:id="@+id/record_category_group" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:chipSpacingHorizontal="@dimen/space_8" app:chipSpacingVertical="@dimen/space_8"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/record_date_button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="@dimen/space_16" android:text="选择日期"/>
   <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="备注（可选）"><com.google.android.material.textfield.TextInputEditText android:id="@+id/record_note_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="2"/></com.google.android.material.textfield.TextInputLayout>
  </LinearLayout>
  <com.google.android.material.button.MaterialButton android:id="@+id/record_save_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="@dimen/space_24" android:text="保存这笔记录"/>
 </LinearLayout>
</ScrollView>
