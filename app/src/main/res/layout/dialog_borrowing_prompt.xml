<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_record_success_dialog"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_leaf" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="要加入借钱统计吗？"
        android:textColor="@color/forest_green"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/borrowing_prompt_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:textColor="@color/wood_brown"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_16"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/borrowing_prompt_skip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="暂不加入借钱统计"
            android:focusable="true"
            android:gravity="center"
            android:text="暂不统计"
            android:textColor="@color/wood_brown"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/borrowing_prompt_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:background="@drawable/bg_details_picker_selected"
            android:clickable="true"
            android:contentDescription="填写借钱统计详情"
            android:focusable="true"
            android:gravity="center"
            android:text="去填写"
            android:textColor="@color/forest_green"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
