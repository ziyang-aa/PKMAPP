<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:clipToPadding="false"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <ImageButton
            android:id="@+id/page_back_button"
            android:layout_width="180dp"
            android:layout_height="135dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回主页面"
            android:scaleType="centerInside"
            android:src="@drawable/return_home_door" />

        <TextView
            android:id="@+id/title_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="明细"
            android:textColor="@color/forest_green"
            android:textSize="28sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/details_ledger_switch_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_8"
            android:contentDescription="切换或新建账本"
            android:text="当前账本" />

        <TextView
            android:id="@+id/details_ledger_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/wood_brown"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/details_tools_card"
            style="@style/Widget.PkmAPP.PaperCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="森林小工具"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/details_fx_tool_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="汇率换算工具"
                    android:text="汇率换算" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/details_borrowing_tool_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:contentDescription="借钱统计工具"
                    android:text="借钱统计" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/details_summary_card"
            style="@style/Widget.PkmAPP.PaperCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月结余"
                android:textColor="@color/ink"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/details_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/forest_green"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/details_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/forest_green" />

            <TextView
                android:id="@+id/details_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/expense_red" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="交易记录"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/details_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_24">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="还没有记账记录"
                android:textColor="@color/wood_brown" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/details_add_record_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/space_8"
                android:text="去记一笔" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/details_transaction_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
