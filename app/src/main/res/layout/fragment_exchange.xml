<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp">

        <!-- Top Bar: soft borderless back icon parallel with serif title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/exchange_back_button"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="返回明细"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back_forest"
                android:stateListAnimator="@animator/editorial_press_alpha" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:gravity="end"
                android:text="汇率换算"
                android:textColor="@color/forest_deep"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quiet status & inline refresh strip directly on warm paper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.pkmapp.forest.ForestLoadingView
                android:id="@+id/exchange_loading"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/exchange_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="正在联网同步最新汇率…"
                android:textColor="@color/wood_brown"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/exchange_refresh_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="刷新汇率"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="32dp"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="↻ 同步汇率"
                android:textColor="@color/forest_deep"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ONE Clean Porcelain Converter Sheet (ZERO inner bordered cards) -->
        <LinearLayout
            android:id="@+id/exchange_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_exchange_card"
            android:elevation="1.5dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Base Currency + Direct Borderless Amount Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="62dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/exchange_base_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:contentDescription="选择原币种"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:stateListAnimator="@animator/editorial_press_alpha">

                    <TextView
                        android:id="@+id/exchange_base_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CNY ▾"
                        android:textColor="@color/ink"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/exchange_base_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="人民币"
                        android:textColor="@color/wood_brown"
                        android:textSize="12sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/exchange_amount_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="serif"
                    android:gravity="end|center_vertical"
                    android:hint="100"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="2dp"
                    android:singleLine="true"
                    android:text="100"
                    android:textColor="@color/ink"
                    android:textColorHint="#B4AFA2"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Hairline Divider + Centered Swap Circle -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_vertical"
                    android:background="#185C4938" />

                <TextView
                    android:id="@+id/exchange_swap_button"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:contentDescription="交换币种"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⇅"
                    android:textColor="@color/forest_deep"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Quote Currency + Direct Oversized Converted Result -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="62dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/exchange_quote_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:contentDescription="选择目标币种"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:stateListAnimator="@animator/editorial_press_alpha">

                    <TextView
                        android:id="@+id/exchange_quote_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USD ▾"
                        android:textColor="@color/ink"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/exchange_quote_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="美元"
                        android:textColor="@color/wood_brown"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/exchange_result"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="serif"
                    android:gravity="end|center_vertical"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="2dp"
                    android:text="--"
                    android:textColor="@color/forest_deep"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Quick Amount Chips Strip -->
            <LinearLayout
                android:id="@+id/exchange_quick_amounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <!-- Footer Hairline + Reference Rate -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#165C4938" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/exchange_rate_caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/wood_brown"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/exchange_copy_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点按结果复制"
                    android:textColor="#9A9284"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/exchange_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/warm_orange"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Direct Hairline Multi-Currency Quick Reference List (NO outer card box!) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="常用货币速览"
                android:textColor="@color/forest_deep"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点按设为目标"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/exchange_multi_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />
    </LinearLayout>
</ScrollView>
