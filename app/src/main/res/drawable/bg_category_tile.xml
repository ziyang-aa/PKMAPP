<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#EDF6DC" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/forest_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B8FFF8DF" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#44C9B88F" />
        </shape>
    </item>
</selector>
