<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_details_picker_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_20"
    android:paddingTop="@dimen/space_20"
    android:paddingEnd="@dimen/space_20"
    android:paddingBottom="@dimen/space_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="FOREST PORTRAIT"
                android:textColor="@color/forest_green"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="森林头像"
                android:textColor="@color/wood_brown"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/profile_avatar_preview_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_checkin_close"
            android:clickable="true"
            android:contentDescription="关闭头像预览"
            android:focusable="true"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/wood_brown"
            android:textSize="22sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="208dp"
        android:layout_height="208dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_profile_avatar_ring"
        android:padding="8dp">

        <ImageView
            android:id="@+id/profile_avatar_preview_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_profile_avatar"
            android:clipToOutline="true"
            android:contentDescription="当前森林头像"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_character" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_12"
        android:text="头像会保存在这台设备的森林档案中"
        android:textColor="@color/brown_soft"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/profile_avatar_preview_change"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_profile_asset_action"
        android:clickable="true"
        android:contentDescription="切换头像"
        android:focusable="true"
        android:gravity="center"
        android:text="切换头像"
        android:textColor="@color/forest_green"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
