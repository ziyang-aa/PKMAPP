<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_borrowing_calendar_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_borrowing_calendar_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/borrowing_calendar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择发生日期"
            android:textColor="@color/wood_brown"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/borrowing_calendar_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭日期选择"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/wood_brown"
            android:textSize="30sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/borrowing_calendar_selected_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/forest_green"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/borrowing_calendar_selected_weekday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/brown_soft"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/borrowing_calendar_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_borrowing_calendar_nav"
            android:contentDescription="上一个月"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/wood_brown"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/borrowing_calendar_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/borrowing_calendar_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_borrowing_calendar_nav"
            android:contentDescription="下一个月"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/wood_brown"
            android:textSize="30sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="一" android:textColor="@color/brown_soft" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="二" android:textColor="@color/brown_soft" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="三" android:textColor="@color/brown_soft" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="四" android:textColor="@color/brown_soft" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="五" android:textColor="@color/brown_soft" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="六" android:textColor="@color/brown_soft" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="日" android:textColor="@color/brown_soft" android:textSize="12sp" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/borrowing_calendar_grid"
        android:layout_width="match_parent"
        android:layout_height="264dp"
        android:background="@drawable/bg_borrowing_calendar_card"
        android:columnCount="7"
        android:padding="6dp"
        android:rowCount="6"
        android:useDefaultMargins="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/borrowing_calendar_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_borrowing_calendar_cancel"
            android:clickable="true"
            android:contentDescription="取消选择日期"
            android:focusable="true"
            android:gravity="center"
            android:text="取消"
            android:textColor="@color/wood_brown"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/borrowing_calendar_confirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1.35"
            android:background="@drawable/bg_borrowing_calendar_confirm"
            android:clickable="true"
            android:contentDescription="确定选择日期"
            android:focusable="true"
            android:gravity="center"
            android:text="确定"
            android:textColor="@color/paper_light"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
