<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFF8DF" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#335C4938" />
        </shape>
    </item>
    <item android:gravity="right|top" android:width="130dp" android:height="130dp">
        <shape android:shape="oval">
            <solid android:color="#38A8D58C" />
        </shape>
    </item>
</layer-list>
