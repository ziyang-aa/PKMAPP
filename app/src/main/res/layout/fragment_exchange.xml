<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fixed_forest_backdrop"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/exchange_back_button"
                android:layout_width="72dp"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回明细"
                android:scaleType="centerInside"
                android:src="@drawable/return_home_door" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="汇率换算"
                android:textColor="@color/forest_green"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="让不同森林里的价格，落在同一片纸上"
            android:textColor="@color/wood_brown"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/exchange_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_exchange_card"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:id="@+id/exchange_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="准备同步最新汇率"
                android:textColor="@color/forest_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="兑换金额"
                android:textColor="@color/wood_brown"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/exchange_amount_input"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_details_picker_option"
                android:hint="输入金额"
                android:inputType="numberDecimal"
                android:paddingHorizontal="@dimen/space_16"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/wood_brown"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/exchange_base_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_details_picker_option"
                    android:clickable="true"
                    android:contentDescription="选择原币种"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="CNY 人民币"
                    android:textColor="@color/wood_brown"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/exchange_swap_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_details_picker_selected"
                    android:clickable="true"
                    android:contentDescription="交换币种"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⇄"
                    android:textColor="@color/forest_green"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/exchange_quote_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_details_picker_option"
                    android:clickable="true"
                    android:contentDescription="选择目标币种"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="USD 美元"
                    android:textColor="@color/wood_brown"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/exchange_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_exchange_result"
                android:gravity="center"
                android:minHeight="88dp"
                android:padding="@dimen/space_12"
                android:text="输入金额后显示结果"
                android:textColor="@color/forest_green"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exchange_rate_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/exchange_refresh_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_details_picker_selected"
                android:clickable="true"
                android:contentDescription="刷新汇率"
                android:focusable="true"
                android:gravity="center"
                android:text="重新同步汇率"
                android:textColor="@color/forest_green"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/exchange_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center"
            android:textColor="@color/warm_orange"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
