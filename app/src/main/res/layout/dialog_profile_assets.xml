<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profile_asset_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_details_picker_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_20"
    android:paddingTop="@dimen/space_20"
    android:paddingEnd="@dimen/space_20"
    android:paddingBottom="@dimen/space_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="FOREST ASSET DESK"
                android:textColor="@color/forest_green"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="管理我的资产"
                android:textColor="@color/wood_brown"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/profile_asset_dialog_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_checkin_close"
            android:clickable="true"
            android:contentDescription="关闭资产管理"
            android:focusable="true"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/wood_brown"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="先记下现在的森林底子，之后每笔收入与支出都会自动更新。"
        android:textColor="@color/wood_brown"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_profile_asset"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前资产"
            android:textColor="@color/wood_brown"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/profile_asset_dialog_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="¥0.00"
            android:textColor="@color/forest_green"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="净资产"
                    android:textColor="@color/wood_brown"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/profile_asset_dialog_net_worth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="¥0.00"
                    android:textColor="@color/forest_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="负债"
                    android:textColor="@color/wood_brown"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/profile_asset_dialog_liability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="¥0.00"
                    android:textColor="@color/warm_orange"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="初始资产"
        android:textColor="@color/wood_brown"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/profile_initial_assets_input"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_details_picker_option"
        android:hint="例如 10000.00"
        android:inputType="numberDecimal"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:selectAllOnFocus="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/brown_soft"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="初始负债"
        android:textColor="@color/wood_brown"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/profile_initial_liabilities_input"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_details_picker_option"
        android:hint="没有负债可填写 0"
        android:inputType="numberDecimal"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:selectAllOnFocus="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/brown_soft"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/profile_asset_dialog_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="取消资产管理"
            android:focusable="true"
            android:gravity="center"
            android:text="取消"
            android:textColor="@color/wood_brown"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/profile_asset_dialog_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1.4"
            android:background="@drawable/bg_profile_asset_action"
            android:clickable="true"
            android:contentDescription="保存资产底子"
            android:focusable="true"
            android:gravity="center"
            android:text="保存资产底子"
            android:textColor="@color/forest_green"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
