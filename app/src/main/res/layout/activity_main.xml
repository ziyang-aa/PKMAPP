<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_bar_height"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingVertical="@dimen/space_8"
        app:selectionRequired="false"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_details"
            style="@style/Widget.PkmAPP.BottomNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nav_details"
            android:textSize="12sp"
            app:icon="@drawable/ic_list"
            app:iconGravity="textTop"
            app:iconPadding="2dp"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_charts"
            style="@style/Widget.PkmAPP.BottomNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nav_charts"
            android:textSize="12sp"
            app:icon="@drawable/ic_chart"
            app:iconGravity="textTop"
            app:iconPadding="2dp"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_record"
            style="@style/Widget.PkmAPP.BottomNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nav_record"
            android:textSize="12sp"
            app:icon="@drawable/ic_add_ledger"
            app:iconGravity="textTop"
            app:iconPadding="2dp"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_savings"
            style="@style/Widget.PkmAPP.BottomNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nav_savings"
            android:textSize="12sp"
            app:icon="@drawable/ic_savings"
            app:iconGravity="textTop"
            app:iconPadding="2dp"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_profile"
            style="@style/Widget.PkmAPP.BottomNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nav_profile"
            android:textSize="12sp"
            app:icon="@drawable/ic_profile"
            app:iconGravity="textTop"
            app:iconPadding="2dp"
            app:iconSize="24dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
