<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_24">
  <LinearLayout android:layout_width="match_parent" android:layout_height="135dp" android:gravity="center_vertical" android:orientation="horizontal">
   <ImageButton android:id="@+id/page_back_button" android:layout_width="120dp" android:layout_height="100dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="返回主页面" android:scaleType="centerInside" android:src="@drawable/return_home_door"/>
   <TextView android:id="@+id/title_charts" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="图表" android:textColor="@color/forest_green" android:textSize="28sp" android:textStyle="bold"/>
  </LinearLayout>
  <com.google.android.material.button.MaterialButtonToggleGroup android:layout_width="match_parent" android:layout_height="48dp" app:singleSelection="true" app:selectionRequired="true">
   <com.google.android.material.button.MaterialButton android:id="@+id/chart_expense_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="支出"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/chart_income_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="收入"/>
  </com.google.android.material.button.MaterialButtonToggleGroup>
  <com.google.android.material.button.MaterialButtonToggleGroup android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="@dimen/space_8" app:singleSelection="true" app:selectionRequired="true">
   <com.google.android.material.button.MaterialButton android:id="@+id/chart_week_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="周"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/chart_month_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="月"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/chart_year_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="年"/>
  </com.google.android.material.button.MaterialButtonToggleGroup>
  <LinearLayout style="@style/Widget.PkmAPP.PaperCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:orientation="vertical" android:padding="@dimen/space_16">
   <TextView android:id="@+id/chart_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textStyle="bold"/>
   <com.example.pkmapp.charts.TrendChartView android:id="@+id/chart_trend_view" android:layout_width="match_parent" android:layout_height="210dp" android:layout_marginTop="@dimen/space_8"/>
  </LinearLayout>
  <LinearLayout style="@style/Widget.PkmAPP.PaperCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:orientation="vertical" android:padding="@dimen/space_16">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分类排行榜" android:textColor="@color/ink" android:textStyle="bold"/>
   <TextView android:id="@+id/chart_ranking" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:textColor="@color/wood_brown" android:textSize="16sp"/>
  </LinearLayout>
 </LinearLayout>
</ScrollView>
