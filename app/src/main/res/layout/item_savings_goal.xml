<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_savings_goal_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/savings_goal_kicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="GOAL CARD · SEEDLING"
            android:textColor="@color/forest_green"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/savings_goal_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_savings_status"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="空白目标"
            android:textColor="@color/wood_brown"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/savings_goal_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/savings_goal_stage_image"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/savings_goal_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/wood_brown"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/savings_goal_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/brown_soft"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/savings_goal_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="目标金额"
                android:textColor="@color/brown_soft"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/savings_goal_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/forest_green"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已存入"
                android:textColor="@color/brown_soft"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/savings_goal_saved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/forest_green"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/savings_goal_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/warm_orange"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/savings_goal_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="11dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_savings" />

    <LinearLayout
        android:id="@+id/savings_goal_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/savings_goal_saved_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/brown_soft"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/savings_goal_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brown_soft"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/savings_goal_editor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3D7B5C3B" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="目标名称"
                    android:textColor="@color/wood_brown"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/savings_goal_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_savings_input"
                    android:hint="例如：周末去看海"
                    android:inputType="textCapSentences"
                    android:maxLength="18"
                    android:maxLines="1"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/brown_soft"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="118dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="目标金额"
                    android:textColor="@color/wood_brown"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp">
                    <EditText
                        android:id="@+id/savings_goal_target_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_savings_input"
                        android:hint="3000"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:paddingStart="25dp"
                        android:paddingEnd="6dp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/brown_soft"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="¥"
                        android:textColor="@color/forest_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/savings_goal_save_button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_savings_save"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="保存这张目标卡"
            android:textColor="@color/paper_light"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/savings_goal_deposit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="存入一笔"
                android:textColor="@color/wood_brown"
                android:textSize="10sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="5dp">
                <EditText
                    android:id="@+id/savings_goal_deposit_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_savings_deposit_input"
                    android:hint="今天想存多少？"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:paddingStart="25dp"
                    android:paddingEnd="11dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/brown_soft"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="¥"
                    android:textColor="@color/warm_orange"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/savings_goal_deposit_button"
            android:layout_width="92dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_savings_deposit"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="放进罐子"
            android:textColor="@color/warm_orange"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/savings_goal_message"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="7dp"
        android:textColor="@color/forest_green"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/savings_goal_delete_button"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_details_delete_action"
        android:clickable="true"
        android:contentDescription="删除这个攒钱目标"
        android:focusable="true"
        android:gravity="center"
        android:text="删除目标"
        android:textColor="@color/expense_red"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
