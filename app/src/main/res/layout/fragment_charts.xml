<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_16">

        <!-- Standard Level-1 Header: Return Door + Right-aligned Bold Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/page_back_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:contentDescription="返回主页面"
                android:scaleType="centerInside"
                android:src="@drawable/return_home_door"
                android:stateListAnimator="@animator/editorial_press_alpha" />

            <TextView
                android:id="@+id/title_charts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="图表"
                android:textColor="@color/forest_green"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 1: Enlarged Editorial Hairline Bar (Left: 22sp/19sp Serif Expense/Income · Right: Compact W/M/Y) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/chart_expense_tab"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="4dp"
                android:stateListAnimator="@animator/editorial_press_alpha">

                <TextView
                    android:id="@+id/chart_expense_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:paddingBottom="8dp"
                    android:text="支出"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/chart_expense_indicator"
                    android:layout_width="28dp"
                    android:layout_height="2.5dp"
                    android:background="@color/forest_green" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chart_income_tab"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="18dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="4dp"
                android:stateListAnimator="@animator/editorial_press_alpha">

                <TextView
                    android:id="@+id/chart_income_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:paddingBottom="8dp"
                    android:text="收入"
                    android:textColor="@color/brown_soft"
                    android:textSize="19sp" />

                <View
                    android:id="@+id/chart_income_indicator"
                    android:layout_width="28dp"
                    android:layout_height="2.5dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="7dp">

                <TextView
                    android:id="@+id/chart_week_button"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="36dp"
                    android:paddingHorizontal="10dp"
                    android:text="周"
                    android:textColor="@color/wood_brown"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chart_month_button"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="36dp"
                    android:paddingHorizontal="10dp"
                    android:text="月"
                    android:textColor="@color/forest_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chart_year_button"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="36dp"
                    android:paddingHorizontal="10dp"
                    android:text="年"
                    android:textColor="@color/wood_brown"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.75dp"
            android:background="#1F5C4938" />

        <!-- Style 3 + Scheme B: Integrated Card-Header Date Stepper + Generous Peeking Watercolor Mascot -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Main Porcelain Trend Card -->
            <LinearLayout
                style="@style/Widget.PkmAPP.PaperCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <!-- Integrated Borderless Card-Header Date Stepper (paddingEnd clears the peeking mascot) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="106dp">

                    <TextView
                        android:id="@+id/chart_period_previous"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="-6dp"
                        android:clickable="true"
                        android:contentDescription="上一周期"
                        android:focusable="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="‹"
                        android:textColor="@color/wood_brown"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/chart_period_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingHorizontal="6dp"
                        android:text="2026年11月 ▾"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chart_period_next"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:clickable="true"
                        android:contentDescription="下一周期"
                        android:focusable="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="›"
                        android:textColor="@color/wood_brown"
                        android:textSize="22sp" />
                </LinearLayout>

                <!-- Delicate Hairline Shelf separating Date Header & Hero Metrics -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.75dp"
                    android:layout_marginTop="2dp"
                    android:background="#1F5C4938" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/chart_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/wood_brown"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chart_total_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="总支出"
                            android:textColor="@color/wood_brown"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chart_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:fontFamily="serif"
                            android:fontFeatureSettings="tnum"
                            android:letterSpacing="-0.02"
                            android:textColor="@color/forest_deep"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chart_average"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/wood_brown"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chart_comparison"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/warm_orange"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.example.pkmapp.charts.TrendChartView
                    android:id="@+id/chart_trend_view"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="@dimen/space_8" />
            </LinearLayout>

            <!-- Scheme B: Generous 104x92dp Watercolor Mascot perched cleanly on top-right card rim -->
            <ImageView
                android:id="@+id/chart_mode_mascot"
                android:layout_width="104dp"
                android:layout_height="92dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="14dp"
                android:clickable="true"
                android:contentDescription="当前统计类型伙伴，点击切换支出或收入"
                android:elevation="4dp"
                android:focusable="true"
                android:scaleType="fitEnd"
                android:src="@drawable/chart_expense_character" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="分类排行榜"
                android:textColor="@color/wood_brown"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chart_ranking_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="支出占比"
                android:textColor="@color/wood_brown"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chart_ranking_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:paddingVertical="0dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
