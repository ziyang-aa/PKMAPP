<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fixed_forest_backdrop">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/bottom_nav_scrim"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav_scrim"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <com.example.pkmapp.forest.FrostedNavigationBar
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_8"
        android:paddingVertical="6dp">

        <com.example.pkmapp.forest.ForestButton
            android:id="@+id/nav_details"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingTop="5dp"
            android:paddingEnd="4dp"
            android:paddingBottom="5dp"
            android:stateListAnimator="@null"
            android:text="@string/nav_details"
            android:textAllCaps="false"
            android:textSize="11sp"
            app:icon="@drawable/ic_list"
            app:iconGravity="textTop"
            app:iconPadding="3dp"
            app:iconSize="20dp"
            app:strokeWidth="0dp" />

        <com.example.pkmapp.forest.ForestButton
            android:id="@+id/nav_charts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingTop="5dp"
            android:paddingEnd="4dp"
            android:paddingBottom="5dp"
            android:stateListAnimator="@null"
            android:text="@string/nav_charts"
            android:textAllCaps="false"
            android:textSize="11sp"
            app:icon="@drawable/ic_chart"
            app:iconGravity="textTop"
            app:iconPadding="3dp"
            app:iconSize="20dp"
            app:strokeWidth="0dp" />

        <com.example.pkmapp.forest.ForestButton
            android:id="@+id/nav_savings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingTop="5dp"
            android:paddingEnd="4dp"
            android:paddingBottom="5dp"
            android:stateListAnimator="@null"
            android:text="@string/nav_savings"
            android:textAllCaps="false"
            android:textSize="11sp"
            app:icon="@drawable/ic_savings"
            app:iconGravity="textTop"
            app:iconPadding="3dp"
            app:iconSize="20dp"
            app:strokeWidth="0dp" />

        <com.example.pkmapp.forest.ForestButton
            android:id="@+id/nav_vault"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingTop="5dp"
            android:paddingEnd="4dp"
            android:paddingBottom="5dp"
            android:stateListAnimator="@null"
            android:text="@string/nav_vault"
            android:textAllCaps="false"
            android:textSize="11sp"
            app:icon="@drawable/ic_vault"
            app:iconGravity="textTop"
            app:iconPadding="3dp"
            app:iconSize="20dp"
            app:strokeWidth="0dp" />
    </com.example.pkmapp.forest.FrostedNavigationBar>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fab_record"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="92dp"
        android:contentDescription="记一笔"
        android:elevation="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="＋ 记一笔"
        android:textAllCaps="false"
        android:textColor="#FFFEFA"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="#456444"
        app:cornerRadius="24dp" />

    <View
        android:id="@+id/home_drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55243624"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/home_drawer_panel"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clipToPadding="false"
        android:elevation="20dp"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/home_drawer_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</FrameLayout>
