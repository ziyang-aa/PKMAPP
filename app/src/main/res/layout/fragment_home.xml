<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <HorizontalScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <include
            android:id="@+id/panorama_scene"
            layout="@layout/view_home_panorama" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/home_welcome_copy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="32dp"
        android:layout_marginTop="92dp"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.16"
            android:shadowColor="@color/home_text_shadow"
            android:shadowRadius="7"
            android:text="FOREST NOTEBOOK"
            android:textColor="@color/paper_light"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:shadowColor="@color/home_text_shadow"
            android:shadowRadius="8"
            android:text="芽叶记"
            android:textColor="@color/paper_light"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:shadowColor="@color/home_text_shadow"
            android:shadowRadius="7"
            android:text="把每一笔生活，留在森林里"
            android:textColor="@color/paper_card"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:shadowColor="@color/home_text_shadow"
            android:shadowRadius="6"
            android:text="今天也和森林伙伴一起，照顾好自己的小目标"
            android:textColor="@color/paper_card"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
