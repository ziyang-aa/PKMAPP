<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFEFA">

    <!-- Step 1: 欢迎回来（本机已有注册账号时展示，复刻图 1） -->
    <ScrollView
        android:id="@+id/auth_step_pick"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/auth_pick_back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_auth_icon_press"
                    android:contentDescription="返回"
                    android:padding="10dp"
                    android:src="@drawable/ic_auth_back"
                    android:visibility="invisible" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="0.5"
                android:minHeight="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.example.pkmapp.forest.SquirrelMascotView
                    android:id="@+id/auth_pick_mascot"
                    android:layout_width="100dp"
                    android:layout_height="100dp" />

                <com.example.pkmapp.forest.SquirrelSpeechBubble
                    android:id="@+id/auth_pick_bubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxWidth="188dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:text="欢迎回来"
                android:textColor="#243624"
                android:textSize="25sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_auth_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/auth_account_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EBE4D8" />

                <LinearLayout
                    android:id="@+id/auth_add_another_account"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_auth_card">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_auth_plus" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="添加其他账号"
                        android:textColor="#7B5C3B"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/auth_manage_accounts_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_auth_text_press"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="管理本机账号"
                android:textColor="#9A8F7E"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <TextView
                android:id="@+id/auth_pick_guest_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_auth_btn_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="先以游客身份体验"
                android:textColor="#315E3A"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- Step 2: 引导分流页（已有账号？ / 初次来到小松果？，复刻图 2） -->
    <LinearLayout
        android:id="@+id/auth_step_choice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/auth_choice_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_auth_icon_press"
                android:contentDescription="返回"
                android:padding="10dp"
                android:src="@drawable/ic_auth_back" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.7" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.example.pkmapp.forest.SquirrelMascotView
                    android:id="@+id/auth_choice_mascot"
                    android:layout_width="88dp"
                    android:layout_height="88dp" />

                <com.example.pkmapp.forest.SquirrelSpeechBubble
                    android:id="@+id/auth_choice_bubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxWidth="188dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="已有账号？"
                android:textColor="#243624"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/auth_go_login_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_auth_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="登录"
                android:textColor="#FFFEFA"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="28dp"
                android:background="#E8E1D5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="初次来到小松果？"
                android:textColor="#243624"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/auth_go_register_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_auth_btn_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="注册新账号"
                android:textColor="#315E3A"
                android:textSize="15.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/auth_choice_guest_button"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_auth_text_press"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="先以游客身份体验"
            android:textColor="#7B5C3B"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Step 3: 登录 / 注册表单页（可动小松鼠 + 旁侧对话气泡 + 独立浮动标签框） -->
    <LinearLayout
        android:id="@+id/auth_step_form"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/auth_form_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_auth_icon_press"
                android:contentDescription="返回"
                android:padding="10dp"
                android:src="@drawable/ic_auth_back" />

            <TextView
                android:id="@+id/auth_form_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="输入账号信息"
                android:textColor="#8E8475"
                android:textSize="17sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingTop="6dp"
                android:paddingBottom="24dp">

                <!-- 可动小松鼠 + 旁侧对话气泡（错误提示 / 欢迎提示 / 互动招手） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal">

                    <com.example.pkmapp.forest.SquirrelMascotView
                        android:id="@+id/auth_form_mascot"
                        android:layout_width="74dp"
                        android:layout_height="74dp" />

                    <com.example.pkmapp.forest.SquirrelSpeechBubble
                        android:id="@+id/auth_form_bubble"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- 独立输入框 1：账号（浮动标签，无占位符） -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/auth_identifier_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="手机号或邮箱"
                    android:textColorHint="#8F8577"
                    app:boxBackgroundColor="#FAF8F3"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/auth_input_stroke"
                    app:boxStrokeWidth="1.2dp"
                    app:boxStrokeWidthFocused="1.8dp"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextColor="@color/forest_deep">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/auth_identifier_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:paddingVertical="15dp"
                        android:textColor="#243624"
                        android:textSize="15.5sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 仅注册模式显示：昵称（独立浮动标签） -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/auth_nickname_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="昵称（选填）"
                    android:textColorHint="#8F8577"
                    android:visibility="gone"
                    app:boxBackgroundColor="#FAF8F3"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/auth_input_stroke"
                    app:boxStrokeWidth="1.2dp"
                    app:boxStrokeWidthFocused="1.8dp"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextColor="@color/forest_deep">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/auth_nickname_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:paddingVertical="15dp"
                        android:textColor="#243624"
                        android:textSize="15.5sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 独立输入框 2：密码（与账号分开，浮动标签，无占位符，带显隐小眼睛） -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/auth_password_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="密码"
                    android:textColorHint="#8F8577"
                    app:boxBackgroundColor="#FAF8F3"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/auth_input_stroke"
                    app:boxStrokeWidth="1.2dp"
                    app:boxStrokeWidthFocused="1.8dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/forest_green"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextColor="@color/forest_deep">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/auth_password_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingVertical="15dp"
                        android:textColor="#243624"
                        android:textSize="15.5sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/auth_submit_button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_auth_btn_primary"
                    android:clickable="true"
                    android:enabled="false"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="登录"
                    android:textColor="#9E9587"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/auth_forgot_or_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_auth_text_press"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="忘记密码"
                    android:textColor="#456444"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="28dp" />

                <TextView
                    android:id="@+id/auth_form_guest_button"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_auth_btn_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="先以游客身份体验"
                    android:textColor="#315E3A"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/auth_agreement_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="登录即表示同意《用户协议》与《隐私政策》"
                    android:textColor="#8E8475"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 联网 / 校验加载浮层（复用 ForestLoadingView 松果跃动动画） -->
    <FrameLayout
        android:id="@+id/auth_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80F5F1E7"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_auth_card"
            android:elevation="6dp"
            android:gravity="center_horizontal"
            android:minWidth="168dp"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="18dp">

            <com.example.pkmapp.forest.ForestLoadingView
                android:id="@+id/auth_loading_view"
                android:layout_width="78dp"
                android:layout_height="34dp" />

            <TextView
                android:id="@+id/auth_loading_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="正在验证账号…"
                android:textColor="#315E3A"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
