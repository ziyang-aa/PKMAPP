<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="108dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="74dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/page_back_button" android:layout_width="56dp" android:layout_height="56dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="返回主页面" android:scaleType="centerInside" android:src="@drawable/return_home_door" />
            <TextView android:id="@+id/title_savings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="serif" android:gravity="end" android:text="攒钱" android:textColor="@color/forest_green" android:textSize="29sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/savings_hero"
            android:layout_width="match_parent"
            android:layout_height="192dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/bg_savings_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="21dp"
            android:paddingTop="21dp"
            android:paddingEnd="8dp"
            android:paddingBottom="21dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="给未来留一片\n更大的森林"
                    android:textColor="@color/forest_green"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="把想去的地方、想做的事，\n分成一小步一小步。"
                    android:textColor="@color/wood_brown"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:contentDescription="@null"
                android:src="@drawable/turtwig_carrying_acorn_jar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="正在靠近的目标"
                android:textColor="@color/wood_brown"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/savings_goal_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wood_brown"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/savings_goal_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/savings_add_goal_button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_savings_add_goal"
            android:clickable="true"
            android:contentDescription="创建新的攒钱目标"
            android:focusable="true"
            android:gravity="center"
            android:text="＋ 新建目标"
            android:textColor="@color/forest_green"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
