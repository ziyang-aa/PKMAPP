<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fixed_forest_backdrop"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/borrowing_back_button"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回明细"
                android:scaleType="centerInside"
                android:src="@drawable/return_home_door" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="森林小工具 · 往来簿"
                    android:textColor="@color/wood_brown"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="借钱统计"
                    android:textColor="@color/forest_green"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_borrowing_top_icon"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_leaf"
                android:tint="@color/forest_green" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="记下每一次借出与借入，森林会替你保留每段来往"
            android:textColor="@color/wood_brown"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/borrowing_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_borrowing_summary"
            android:orientation="vertical"
            android:padding="@dimen/space_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="往来总览"
                    android:textColor="@color/borrowing_summary_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_borrowing_badge"
                    android:paddingStart="9dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="6dp"
                    android:text="自动汇总"
                    android:textColor="@color/borrowing_summary_text"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_borrowing_dot_lend" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="我借出去"
                            android:textColor="@color/borrowing_summary_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/borrowing_lend_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:textColor="@color/borrowing_summary_text"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/borrowing_lend_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textColor="@color/borrowing_summary_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/borrowing_summary_divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_20"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_borrowing_dot_borrow" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="我借进来"
                            android:textColor="@color/borrowing_summary_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/borrowing_borrow_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:textColor="@color/borrowing_summary_text"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/borrowing_borrow_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textColor="@color/borrowing_summary_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/borrowing_composer_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:background="@drawable/bg_borrowing_composer"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="记录一笔往来"
                    android:textColor="@color/wood_brown"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/borrowing_mode_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="现在：借出"
                    android:textColor="@color/wood_brown"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_borrowing_segment"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/borrowing_direction_lend"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_details_picker_selected"
                    android:clickable="true"
                    android:contentDescription="选择借出"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="借出给别人"
                    android:textColor="@color/forest_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/borrowing_direction_borrow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_details_picker_option"
                    android:clickable="true"
                    android:contentDescription="选择借入"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="向别人借入"
                    android:textColor="@color/wood_brown"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_borrowing_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_borrowing_field_icon"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_info"
                    android:tint="@color/forest_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="金额"
                        android:textColor="@color/wood_brown"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/borrowing_amount_input"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:background="@null"
                        android:hint="0.00"
                        android:includeFontPadding="false"
                        android:inputType="numberDecimal"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/brown_soft"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_borrowing_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_borrowing_field_icon"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_person"
                    android:tint="@color/forest_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="对方"
                        android:textColor="@color/wood_brown"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/borrowing_person_input"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:background="@null"
                        android:hint="例如：小林"
                        android:includeFontPadding="false"
                        android:inputType="textPersonName"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/brown_soft"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/borrowing_date_field"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_borrowing_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_borrowing_field_icon"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/forest_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="发生日期"
                        android:textColor="@color/wood_brown"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/borrowing_date_button"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_borrowing_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_borrowing_field_icon"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_note"
                    android:tint="@color/forest_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="备注（选填）"
                        android:textColor="@color/wood_brown"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/borrowing_note_input"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:background="@null"
                        android:hint="例如：晚饭先垫付"
                        android:includeFontPadding="false"
                        android:inputType="textCapSentences"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/brown_soft"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/borrowing_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textColor="@color/forest_green"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/borrowing_save_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_details_picker_selected"
                android:clickable="true"
                android:contentDescription="保存借钱记录"
                android:focusable="true"
                android:gravity="center"
                android:text="保存这笔往来"
                android:textColor="@color/forest_green"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="最近往来"
                android:textColor="@color/wood_brown"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="按日期留下脚印"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/borrowing_record_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/borrowing_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_16"
            android:text="还没有留下往来记录"
            android:textColor="@color/wood_brown"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
