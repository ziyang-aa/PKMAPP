<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_borrowing_record"
    android:minHeight="76dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_12"
    android:paddingTop="@dimen/space_12"
    android:paddingEnd="@dimen/space_12"
    android:paddingBottom="@dimen/space_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/borrowing_record_avatar"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_borrowing_avatar"
            android:gravity="center"
            android:textColor="@color/forest_green"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

        <TextView
            android:id="@+id/borrowing_record_direction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="@color/wood_brown"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/borrowing_record_person"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/borrowing_record_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/wood_brown"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/borrowing_record_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/expense_red"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/borrowing_record_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textColor="@color/wood_brown"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
