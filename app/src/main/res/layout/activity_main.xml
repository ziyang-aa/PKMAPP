<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fixed_forest_backdrop">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_bottom_bar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingVertical="@dimen/space_4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_details"
                style="@style/Widget.PkmAPP.BottomNavButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/nav_details"
                android:text=""
                app:icon="@drawable/ic_list"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                app:iconSize="22dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_details"
                android:textColor="@color/nav_item_tint"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_charts"
                style="@style/Widget.PkmAPP.BottomNavButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/nav_charts"
                android:text=""
                app:icon="@drawable/ic_chart"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                app:iconSize="22dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_charts"
                android:textColor="@color/nav_item_tint"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_record"
            style="@style/Widget.PkmAPP.BottomNavRecordButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nav_record"
            android:textSize="13sp"
            android:translationY="-8dp"
            app:icon="@drawable/ic_add_ledger_primary"
            app:iconGravity="textTop"
            app:iconPadding="0dp"
            app:iconSize="60dp"
            app:iconTint="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_savings"
                style="@style/Widget.PkmAPP.BottomNavButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/nav_savings"
                android:text=""
                app:icon="@drawable/ic_savings"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                app:iconSize="22dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_savings"
                android:textColor="@color/nav_item_tint"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_profile"
                style="@style/Widget.PkmAPP.BottomNavButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/nav_profile"
                android:text=""
                app:icon="@drawable/ic_profile"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                app:iconSize="22dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_profile"
                android:textColor="@color/nav_item_tint"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
