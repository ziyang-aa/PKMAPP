<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/details_ledger_picker_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_details_picker_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_20"
    android:paddingTop="@dimen/space_20"
    android:paddingEnd="@dimen/space_20"
    android:paddingBottom="@dimen/space_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="FOREST LEDGER"
                android:textColor="@color/forest_green"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="选择森林账本"
                android:textColor="@color/wood_brown"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/details_ledger_picker_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_checkin_close"
            android:clickable="true"
            android:contentDescription="关闭账本选择"
            android:focusable="true"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/wood_brown"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="每本账本都保存一段森林里的生活"
        android:textColor="@color/wood_brown"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/details_ledger_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/details_new_ledger_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_details_picker_selected"
        android:clickable="true"
        android:contentDescription="新建账本"
        android:focusable="true"
        android:gravity="center"
        android:text="＋  新建森林账本"
        android:textColor="@color/forest_green"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/details_ledger_picker_cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_4"
        android:clickable="true"
        android:contentDescription="取消账本选择"
        android:focusable="true"
        android:gravity="center"
        android:text="先不切换"
        android:textColor="@color/wood_brown"
        android:textSize="13sp" />
</LinearLayout>
