<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fixed_forest_backdrop"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="88dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">
        <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/page_back_button" android:layout_width="88dp" android:layout_height="72dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="返回主页面" android:scaleType="centerInside" android:src="@drawable/return_home_door" />
            <TextView android:id="@+id/title_record" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="记一笔" android:textColor="@color/forest_green" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/record_type_group" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_chart_toggle" android:orientation="horizontal" android:padding="@dimen/space_4">
            <TextView android:id="@+id/record_type_expense" style="@style/Widget.PkmAPP.RecordToggleExpense" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="支出" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/record_type_income" style="@style/Widget.PkmAPP.RecordToggleIncome" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="收入" android:clickable="true" android:focusable="true" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:text="选择分类" android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" />
        <GridLayout android:id="@+id/record_category_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:columnCount="4" />

        <LinearLayout android:id="@+id/record_entry_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/record_selected_category" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_selected_category" android:gravity="center_vertical" android:paddingHorizontal="@dimen/space_12" android:textColor="@color/forest_green" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:text="发生日期" android:textColor="@color/wood_brown" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/record_date_button" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="@dimen/space_8" android:orientation="horizontal">
                <TextView android:id="@+id/record_date_year" style="@style/Widget.PkmAPP.DatePickerBox" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <TextView android:id="@+id/record_date_month" style="@style/Widget.PkmAPP.DatePickerBox" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="@dimen/space_8" android:layout_weight="1" />
                <TextView android:id="@+id/record_date_day" style="@style/Widget.PkmAPP.DatePickerBox" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="@dimen/space_8" android:layout_weight="1" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/record_amount_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" app:prefixText="¥">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/record_amount_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:id="@+id/record_calculator_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:background="@drawable/bg_calculator_panel" android:orientation="vertical" android:paddingTop="@dimen/space_12">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal" android:paddingHorizontal="@dimen/space_12">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="森林计算器" android:textColor="@color/wood_brown" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="先算清楚，再记入账本" android:textColor="@color/wood_brown" android:textSize="10sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/record_calculator_expression" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical|end" android:maxLines="1" android:text="输入花销" android:textColor="@color/wood_brown" android:textSize="10sp" />
                </LinearLayout>
                <TextView android:id="@+id/record_calculator_display" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/bg_calculator_display" android:gravity="center_vertical|end" android:maxLines="1" android:ellipsize="end" android:paddingHorizontal="@dimen/space_12" android:text="0.00" android:textColor="@color/ink" android:textSize="30sp" />
                <EditText android:id="@+id/record_note_input" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginHorizontal="@dimen/space_12" android:layout_marginTop="@dimen/space_8" android:background="@drawable/bg_calculator_note" android:hint="点击填写备注" android:inputType="textCapSentences" android:paddingHorizontal="@dimen/space_12" android:textColor="@color/ink" android:textColorHint="@color/wood_brown" android:textSize="14sp" />
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="4" android:rowCount="4">
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_7" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="7" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_8" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="8" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_9" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="9" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_ac" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="AC" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_4" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="4" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_5" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="5" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_6" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="6" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_add" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="+" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_1" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="1" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_2" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="2" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_3" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="3" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_subtract" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="−" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_dot" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="." />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_0" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="0" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_backspace" style="@style/Widget.PkmAPP.CalculatorKey" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="⌫" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/record_key_equals" style="@style/Widget.PkmAPP.CalculatorEquals" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:text="=" />
                </GridLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/record_save_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="@dimen/space_16" android:text="收进森林账本" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
